# Copiar este archivo a .env y completar los valores reales.
# El .env real NUNCA se sube al repositorio (ver .gitignore).
#
# IMPORTANTE: Vite incrusta estos valores en el código en el momento del
# build (npm run build), no los lee en vivo del servidor. Si cambia
# cualquiera de estos valores, hay que volver a correr el build y
# redesplegar los archivos generados — no alcanza con reiniciar nada.

# URL pública del backend. En desarrollo (npm run dev) se puede dejar
# vacío, cae solo a http://localhost:3000. En producción, obligatorio:
# el dominio real donde corre la API (con https://).
VITE_API_URL=

# Site key de Cloudflare Turnstile (la pública, no la secreta — la
# secreta va en el .env del backend). Sacarla del dashboard de
# Cloudflare > Turnstile > el widget correspondiente.
VITE_TURNSTILE_SITE_KEY=
