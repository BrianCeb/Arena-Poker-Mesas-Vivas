// ─────────────────────────────────────────────────────────────
// Mesas Vivas — Schema de base de datos
// Traducción directa del modelo acordado en el diseño previo.
// ─────────────────────────────────────────────────────────────
//
// MIGRACIÓN A MYSQL/MARIADB (21/9): cambiado el provider de postgresql a
// mysql.
//
// RESUELTO (22/9): las 3 restricciones de unicidad que en Postgres vivían
// como índices únicos PARCIALES (con WHERE) — algo que MySQL/MariaDB no
// soporta — están implementadas con una columna que vale NULL cuando la
// fila no está "activa", con un índice único sobre esa columna.
// MySQL/MariaDB tratan cada NULL como distinto, mismo efecto que el
// WHERE parcial de Postgres. Dos de las tres usan columnas GENERATED
// ALWAYS AS ... STORED; la de waiting_list_entries.active_per_table_key
// usa en cambio un TRIGGER (BEFORE INSERT/UPDATE) porque involucra
// `table_id`, que es una foreign key — MySQL/MariaDB no permiten que una
// columna generada referencie una columna con FK. Viven en la migración
// `mysql_partial_unique_workaround` (SQL manual, no generado por Prisma)
// y NO están modeladas acá abajo como columnas del modelo — Prisma no
// tiene soporte de primera clase para columnas generadas ni triggers en
// MySQL. La app nunca las toca directamente, solo existen para que la
// base rechace inserts/updates inconsistentes (Prisma lo reporta como
// P2002, igual que con los índices parciales de Postgres):
//   - casino_tables.name_active (índice: casino_tables_name_active_unique)
//   - waiting_list_entries.active_per_table_key (vía trigger)
//     (índice: waiting_list_entries_active_per_table_unique)
//   - waiting_list_entries.seated_key
//     (índice: waiting_list_entries_seated_unique)
//
// IMPORTANTE: por esto mismo, nunca correr `prisma db push` contra esta
// base — compararía el schema.prisma (que no conoce estas columnas)
// contra la base real y las borraría pensando que son drift. Usar
// siempre `prisma migrate dev` / `prisma migrate deploy`.
//
// (28/9) Agregado el estado PRESENTE a WaitingListStatus — ver la
// migración `add_marketing_consent_and_presente_status`. IMPORTANTE: esa
// migración también actualiza a mano los triggers de
// active_per_table_key para que reconozcan 'PRESENTE' como estado
// "activo" — si se vuelve a tocar ese trigger en el futuro, no olvidar
// incluir los 3 estados (ANOTADO, PRESENTE, SENTADO).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────

enum DocumentType {
  DNI
  LC
  LE
  PASAPORTE
}

enum UserStatus {
  PENDIENTE
  ACTIVA
  BLOQUEADA
  DESHABILITADA
}

enum TableStatus {
  CERRADA
  ABIERTA
  SUSPENDIDA
}

enum StradleMode {
  NO
  OPCIONAL
  OBLIGATORIO
}

enum WaitingListOrigin {
  APP
  MANUAL_STAFF
}

enum WaitingListStatus {
  ANOTADO
  PRESENTE
  SENTADO
  RETIRADO
  CANCELADO_ADMIN
}

enum TournamentStatus {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

// ── USUARIOS Y AUTENTICACIÓN ─────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  documentType        DocumentType @map("document_type")
  documentNumber      String    @map("document_number")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  sex                 String
  email               String    @unique
  emailVerifiedAt     DateTime? @map("email_verified_at")
  phone               String?
  nickname            String?
  passwordHash        String    @map("password_hash")
  birthDate           DateTime  @map("birth_date")
  status              UserStatus @default(PENDIENTE)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  marketingConsent    Boolean   @default(false) @map("marketing_consent")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  roles                UserRole[]
  waitingListEntries   WaitingListEntry[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
  termsAcceptances     UserTermsAcceptance[]
  auditLogsAsActor     AuditLog[] @relation("AuditActor")
  tablesCreated        CasinoTable[] @relation("TableCreatedBy")
  statusChangesActor   TableStatusHistory[] @relation("StatusChangedBy")
  entriesCancelledAsAdmin WaitingListEntry[] @relation("EntryCancelledBy")
  rolesAssignedByMe    UserRole[] @relation("RoleAssignedBy")
  tournamentsCreated   Tournament[] @relation("TournamentCreatedBy")

  @@unique([documentType, documentNumber])
  @@index([email])
  @@index([documentNumber])
  @@index([status])
  @@map("users")
}

model Role {
  id          String @id @default(uuid())
  name        String @unique // OPERADOR, SUPERVISOR, ADMIN
  description String?

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")

  user           User  @relation(fields: [userId], references: [id])
  role           Role  @relation(fields: [roleId], references: [id])
  assignedByUser User? @relation("RoleAssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ── MESAS ──────────────────────────────────────────────────────

model CasinoTable {
  id                 String      @id @default(uuid())
  name               String
  gameType           String      @map("game_type")
  smallBlind         Decimal     @map("small_blind")
  bigBlind           Decimal     @map("big_blind")
  minBuyIn           Decimal?    @map("min_buy_in")
  maxBuyIn            Decimal?    @map("max_buy_in")
  capacity           Int         @default(9)
  minPlayersToStart  Int         @default(4) @map("min_players_to_start")
  stradleMode        StradleMode @default(NO) @map("stradle_mode")
  stradleAmount      Decimal?    @map("stradle_amount")
  status             TableStatus @default(CERRADA)
  openedAt           DateTime?   @map("opened_at")
  closedAt           DateTime?   @map("closed_at")
  notes              String?
  createdBy          String      @map("created_by")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")

  // Columna generada por la base (no por Prisma) para el workaround de
  // MySQL de índice único parcial — ver la nota grande al principio de
  // este archivo. Unsupported() le dice a Prisma "esta columna existe,
  // no la borres", pero no genera ningún campo utilizable en el cliente
  // — la app nunca la lee ni la escribe directamente.
  nameActive         Unsupported("varchar(191)")? @map("name_active")

  creator            User @relation("TableCreatedBy", fields: [createdBy], references: [id])
  waitingListEntries WaitingListEntry[]
  statusHistory      TableStatusHistory[]

  @@index([status])
  @@unique([nameActive], map: "casino_tables_name_active_unique")
  @@map("casino_tables")
}

model TableStatusHistory {
  id             String      @id @default(uuid())
  tableId        String      @map("table_id")
  previousStatus TableStatus @map("previous_status")
  newStatus      TableStatus @map("new_status")
  changedBy      String      @map("changed_by")
  changedAt      DateTime    @default(now()) @map("changed_at")
  reason         String?

  table       CasinoTable @relation(fields: [tableId], references: [id])
  changedByUser User      @relation("StatusChangedBy", fields: [changedBy], references: [id])

  @@index([tableId])
  @@map("table_status_history")
}

// ── LISTA DE ESPERA ───────────────────────────────────────────
// NOTA: las restricciones de unicidad ("un jugador no puede tener
// dos inscripciones activas en la MISMA mesa" y "no puede estar
// SENTADO en más de una mesa a la vez") NO se pueden expresar como
// @@unique condicional en Prisma. Implementadas vía columnas
// generadas en una migración SQL manual — ver nota de MIGRACIÓN A
// MYSQL al principio de este archivo.

model WaitingListEntry {
  id             String            @id @default(uuid())
  userId         String?           @map("user_id")
  tableId        String            @map("table_id")
  documentType   DocumentType      @map("document_type")
  documentNumber String            @map("document_number")
  firstName      String            @map("first_name")
  lastName       String            @map("last_name")
  status         WaitingListStatus @default(ANOTADO)
  origin         WaitingListOrigin @default(APP)
  createdAt      DateTime          @default(now()) @map("created_at")
  seatedAt       DateTime?         @map("seated_at")
  leftAt         DateTime?         @map("left_at")
  cashOutAmount  Decimal?          @map("cash_out_amount")
  cashOutAt      DateTime?         @map("cash_out_at")
  cancelledBy    String?           @map("cancelled_by")
  cancelReason   String?           @map("cancel_reason")

  // Columnas del workaround de MySQL de índice único parcial — ver la
  // nota grande al principio de este archivo. Unsupported() le dice a
  // Prisma "estas columnas existen, no las borres", pero no generan
  // ningún campo utilizable en el cliente — la app nunca las toca.
  activePerTableKey Unsupported("char(64)")? @map("active_per_table_key")
  seatedKey         Unsupported("char(64)")? @map("seated_key")

  user            User?       @relation(fields: [userId], references: [id])
  table           CasinoTable @relation(fields: [tableId], references: [id])
  cancelledByUser User?       @relation("EntryCancelledBy", fields: [cancelledBy], references: [id])

  @@index([tableId, status])
  @@index([userId, status])
  @@index([documentType, documentNumber])
  @@unique([activePerTableKey], map: "waiting_list_entries_active_per_table_unique")
  @@unique([seatedKey], map: "waiting_list_entries_seated_unique")
  @@map("waiting_list_entries")
}

// ── AUDITORÍA ──────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ── TORNEOS ────────────────────────────────────────────────────

model Tournament {
  id                    String            @id @default(uuid())
  name                  String
  type                  String
  startsAt              DateTime          @map("starts_at")
  registrationClosesAt  DateTime          @map("registration_closes_at")
  buyIn                 Decimal           @map("buy_in")
  rake                  Decimal
  initialStack          Int?              @map("initial_stack")
  blindsIntervalMinutes Int?              @map("blinds_interval_minutes")
  reEntryEnabled         Boolean           @default(false) @map("re_entry_enabled")
  reEntryClosesAt        DateTime?         @map("re_entry_closes_at")
  addOnEnabled           Boolean           @default(false) @map("add_on_enabled")
  addOnPrice             Decimal?          @map("add_on_price")
  addOnRake              Decimal?          @map("add_on_rake")
  addOnChips             Int?              @map("add_on_chips")
  addOnLevel             Int?              @map("add_on_level")
  guaranteedPot          Decimal?          @map("guaranteed_pot")
  flyerImageUrl          String?           @map("flyer_image_url")
  structureImageUrl      String?           @map("structure_image_url")
  notes                  String?
  status                 TournamentStatus  @default(PROGRAMADO)
  createdBy              String            @map("created_by")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  deletedAt               DateTime?         @map("deleted_at")

  creator User @relation("TournamentCreatedBy", fields: [createdBy], references: [id])

  @@index([status])
  @@index([startsAt])
  @@map("tournaments")
}

// ── TÉRMINOS Y CONDICIONES ──────────────────────────────────────

model TermsVersion {
  id           String   @id @default(uuid())
  versionLabel String   @map("version_label")
  content      String
  publishedAt  DateTime @default(now()) @map("published_at")
  isCurrent    Boolean  @default(false) @map("is_current")

  acceptances UserTermsAcceptance[]

  @@map("terms_versions")
}

model UserTermsAcceptance {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  termsVersionId String   @map("terms_version_id")
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  ipAddress      String?  @map("ip_address")

  user         User         @relation(fields: [userId], references: [id])
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id])

  @@unique([userId, termsVersionId])
  @@map("user_terms_acceptance")
}
