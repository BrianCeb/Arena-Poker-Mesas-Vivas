# Copiar este archivo a .env y completar los valores reales.
# El .env real NUNCA se sube al repositorio (ver .gitignore).

# ── Entorno ──
# "production" en el servidor real, "development" en una PC de trabajo.
NODE_ENV=development

PORT=3000

# ── Base de datos (MySQL/MariaDB) ──
# Formato: mysql://usuario:contraseña@host:puerto/nombre_de_base
DATABASE_URL="mysql://usuario:password@host:3306/mesas_vivas"

# ── Autenticación ──
# String largo y aleatorio, distinto en cada ambiente (dev/producción).
# Generar uno nuevo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── SMTP (envío de emails: verificación de cuenta, reset de contraseña) ──
SMTP_HOST=mail.arenamaipu.com.ar
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=arenapoker@arenamaipu.com.ar
SMTP_PASS=
EMAIL_FROM="Arena Poker <arenapoker@arenamaipu.com.ar>"

# ── Captcha (Cloudflare Turnstile) ──
# Secret key del widget — la pública (site key) va en el .env del frontend,
# no acá. Sacar ambas del dashboard de Cloudflare > Turnstile.
TURNSTILE_SECRET_KEY=

# ── URLs ──
# URL pública donde corre ESTE backend — se usa para armar los links que
# van en los emails (verificación de cuenta, reset de contraseña).
# En producción es el dominio real (con https://), no localhost.
BACKEND_BASE_URL=http://localhost:3000

# Dominio del FRONTEND que tiene permitido llamar a esta API (CORS).
# En producción es el dominio real donde se sirve la app (con https://).
FRONTEND_ORIGIN=http://localhost:5173

# ── Seed (npm run seed) ──
# Email que va a quedar como ADMIN al correr el seed. Si no se define,
# usa un valor por defecto en el código — mejor definirlo explícitamente
# en producción.
SEED_ADMIN_EMAIL=

# Si NODE_ENV=production, el seed NO crea mesas de ejemplo por defecto
# (evita ensuciar la base real con datos falsos). Para forzar el
# comportamiento en cualquier ambiente, descomentar una de estas dos:
# SEED_DEMO_TABLES=true
# SEED_DEMO_TABLES=false

# ── Alertas anti-fraude ──
# Ventana, en minutos, para avisar si se vuelve a sentar a alguien que
# cobró fichas hace poco. Si no se define, usa 120 (2 horas) por defecto.
RECENT_CASHOUT_WINDOW_MINUTES=120
