# Copiar este archivo a .env y completar los valores reales.
# El .env real NUNCA se sube al repositorio (ver .gitignore).

# MySQL/MariaDB (migrado desde Postgres el 21/9). Formato:
# mysql://usuario:contraseña@host:puerto/nombre_de_base
# Pendiente completar con los datos reales que pase Horacio.
DATABASE_URL="mysql://usuario:password@host:3306/mesas_vivas"

PORT=3000

# JWT_SECRET=

# SMTP (Arena Maipú / Horacio)
SMTP_HOST=mail.arenamaipu.com.ar
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=poker@arenamaipu.com.ar
SMTP_PASS=
EMAIL_FROM="Arena Poker <poker@arenamaipu.com.ar>"

# URL base pública del backend, usada para armar los links de los emails
# (verificación de cuenta, reset de contraseña). En producción va a ser
# el dominio real, no localhost.
BACKEND_BASE_URL=http://localhost:3000
